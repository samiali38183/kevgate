{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "kevgate chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "quantity": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|Mi|Gi|Ti|M|G|T)?$" },
        { "type": "number", "minimum": 0 }
      ]
    },
    "resourceMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": { "$ref": "#/definitions/quantity" },
        "memory": { "$ref": "#/definitions/quantity" },
        "ephemeral-storage": { "$ref": "#/definitions/quantity" }
      },
      "required": ["cpu", "memory"]
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "seccomp": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["RuntimeDefault", "Localhost"] },
        "localhostProfile": { "type": "string" }
      }
    }
  },
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 0 },
    "scaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "acknowledgeSqliteSplitState": { "type": "boolean" } }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "not": { "const": "latest" } },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } } }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "env": { "enum": ["dev", "prod"] },
        "logLevel": { "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"] },
        "rateLimitPerMin": { "type": "integer", "minimum": 1 },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "not": { "enum": ["KEVGATE_API_KEYS_FILE", "KEVGATE_DB_PATH", "KEVGATE_ENV"] }
              }
            }
          }
        }
      }
    },
    "apiKeys": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "secretKey": { "type": "string", "pattern": "^[-._a-zA-Z0-9]+$" },
        "create": { "type": "boolean" },
        "entries": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[^:\\s]+:.+:[^:\\s]+$" }
        },
        "mountPath": { "type": "string", "pattern": "^/" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "$ref": "#/definitions/labels" }
      }
    },
    "podAnnotations": { "$ref": "#/definitions/labels" },
    "podLabels": { "$ref": "#/definitions/labels" },
    "podSecurityContext": {
      "type": "object",
      "required": ["runAsNonRoot", "seccompProfile"],
      "properties": {
        "runAsNonRoot": { "const": true },
        "runAsUser": { "type": "integer", "minimum": 1 },
        "runAsGroup": { "type": "integer", "minimum": 1 },
        "fsGroup": { "type": "integer", "minimum": 1 },
        "fsGroupChangePolicy": { "enum": ["OnRootMismatch", "Always"] },
        "seccompProfile": { "$ref": "#/definitions/seccomp" }
      }
    },
    "securityContext": {
      "type": "object",
      "required": ["allowPrivilegeEscalation", "readOnlyRootFilesystem", "runAsNonRoot", "capabilities"],
      "properties": {
        "allowPrivilegeEscalation": { "const": false },
        "privileged": { "const": false },
        "readOnlyRootFilesystem": { "const": true },
        "runAsNonRoot": { "const": true },
        "runAsUser": { "type": "integer", "minimum": 1 },
        "runAsGroup": { "type": "integer", "minimum": 1 },
        "capabilities": {
          "type": "object",
          "required": ["drop"],
          "properties": {
            "drop": { "type": "array", "contains": { "const": "ALL" } },
            "add": { "type": "array", "maxItems": 0 }
          }
        },
        "seccompProfile": { "$ref": "#/definitions/seccomp" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "$ref": "#/definitions/resourceMap" },
        "limits": { "$ref": "#/definitions/resourceMap" }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "liveness", "readiness"],
      "properties": {
        "startup": { "$ref": "#/definitions/probe" },
        "liveness": { "$ref": "#/definitions/probe" },
        "readiness": { "$ref": "#/definitions/probe" }
      }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["pvc", "emptyDir"] },
        "storageClassName": { "type": "string" },
        "accessMode": { "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany"] },
        "size": { "$ref": "#/definitions/quantity" },
        "existingClaim": { "type": "string" },
        "emptyDirSizeLimit": { "$ref": "#/definitions/quantity" }
      }
    },
    "tmpSizeLimit": { "$ref": "#/definitions/quantity" },
    "kevFeed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "configMap": { "type": "string" },
        "configMapKey": { "type": "string" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clientPodLabels": { "$ref": "#/definitions/labels", "minProperties": 1 },
            "clientNamespaceLabels": { "$ref": "#/definitions/labels" },
            "metrics": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "namespaceLabels": { "$ref": "#/definitions/labels" },
                "podLabels": { "$ref": "#/definitions/labels" }
              }
            }
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dns": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "namespaceLabels": { "$ref": "#/definitions/labels" },
                "podLabels": { "$ref": "#/definitions/labels" }
              }
            },
            "kevFeed": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "cidr": { "type": "string" },
                "except": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string" },
            "scrapeTimeout": { "type": "string" },
            "labels": { "$ref": "#/definitions/labels" }
          }
        }
      }
    },
    "nodeSelector": { "$ref": "#/definitions/labels" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "priorityClassName": { "type": "string" }
  }
}
